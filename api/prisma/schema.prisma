
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id       Int     @id @default(autoincrement())
  username String
  email    String  @unique
  password String
  img      String?

  posts    Post[]
}

model Post {
  id    Int      @id @default(autoincrement())
  title String
  desc  String   @db.Text
  img   String?
  date  DateTime @default(now())
  uid   Int

  user  User     @relation(fields: [uid], references: [id], onDelete: Cascade)

  @@index([uid])
}